APP_NAME=MOSAIC API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DB_USER=mosaic
DB_PASSWORD=mosaic
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mosaic
SECRET_KEY=replace-with-a-long-random-development-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
STORAGE_ROOT=.mosaic-storage
MAX_UPLOAD_SIZE_BYTES=25000000
REPORT_EXPORT_MAX_ROWS=50000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
BACKEND_CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Google OAuth is disabled while these values are blank.
# Create them at https://console.cloud.google.com/apis/credentials:
# 1. Create/select a Google Cloud project.
# 2. Configure the OAuth consent screen.
# 3. Create an OAuth client ID with application type "Web application".
# 4. Add this exact authorized redirect URI:
#    http://localhost:8000/api/v1/auth/google/callback
# Copy the generated values below. Do not commit the client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# SMTP is optional in development; without it, the verification link is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mosaic.local
SMTP_USE_TLS=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30
